{
  "entities": {
    "Company": {
      "title": "Company",
      "description": "A business entity on the platform",
      "type": "object",
      "properties": {
        "name": { "type": "string", "description": "Company name" },
        "taxNumber": { "type": "string", "description": "VAT/Tax number" },
        "ownerUid": { "type": "string", "description": "UID of the company owner" },
        "plan": { "type": "string", "enum": ["free", "pro", "enterprise"] },
        "sectorKey": { "type": "string", "description": "Business sector key" },
        "onboardingCompleted": { "type": "boolean", "description": "Whether onboarding is done" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "ownerUid", "sectorKey"]
    },
    "CompanyModule": {
      "title": "CompanyModule",
      "description": "Enabled modules for a company",
      "type": "object",
      "properties": {
        "companyId": { "type": "string" },
        "moduleKey": { "type": "string" },
        "isEnabled": { "type": "boolean" },
        "enabledBy": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "User": {
      "title": "User",
      "description": "A user within a company",
      "type": "object",
      "properties": {
        "fullName": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "role": { "type": "string", "enum": ["owner", "admin", "accountant", "cashier", "viewer", "sales", "inventory", "hr"] },
        "isOwner": { "type": "boolean" },
        "permissions": { "type": "array", "items": { "type": "string" } },
        "companyId": { "type": "string" },
        "active": { "type": "boolean" }
      },
      "required": ["fullName", "email", "role", "companyId"]
    },
    "Invoice": {
      "title": "Invoice",
      "description": "Sales or Purchase invoice",
      "type": "object",
      "properties": {
        "number": { "type": "string" },
        "type": { "type": "string", "enum": ["sale", "purchase"] },
        "customerId": { "type": "string" },
        "date": { "type": "string", "format": "date" },
        "dueDate": { "type": "string", "format": "date" },
        "total": { "type": "number" },
        "tax": { "type": "number" },
        "status": { "type": "string", "enum": ["draft", "issued", "paid", "overdue", "cancelled"] },
        "companyId": { "type": "string" }
      },
      "required": ["number", "type", "date", "total", "companyId"]
    },
    "Product": {
      "title": "Product",
      "description": "Inventory item",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "sku": { "type": "string" },
        "price": { "type": "number" },
        "stock": { "type": "number" },
        "companyId": { "type": "string" }
      },
      "required": ["name", "price", "stock", "companyId"]
    },
    "InventoryAdjustment": {
      "title": "InventoryAdjustment",
      "description": "Individual stock adjustment entry",
      "type": "object",
      "properties": {
        "productId": { "type": "string" },
        "productName": { "type": "string" },
        "adjustmentQuantity": { "type": "number" },
        "newStock": { "type": "number" },
        "reason": { "type": "string", "enum": ["damage", "correction", "expired", "return", "other"] },
        "referenceNumber": { "type": "string" },
        "adjustedByUserID": { "type": "string" },
        "date": { "type": "string", "format": "date" },
        "companyId": { "type": "string" }
      },
      "required": ["productId", "adjustmentQuantity", "newStock", "reason", "referenceNumber", "adjustedByUserID", "date", "companyId"]
    }
  },
  "firestore": {
    "/companies/{companyId}": {
      "schema": "Company",
      "description": "Company profile"
    },
    "/companies/{companyId}/modules/{moduleId}": {
      "schema": "CompanyModule",
      "description": "Enabled modules for the company"
    },
    "/users/{userId}": {
      "schema": "User",
      "description": "User profile and role"
    },
    "/companies/{companyId}/invoices/{invoiceId}": {
      "schema": "Invoice",
      "description": "Company invoices"
    },
    "/products/{productId}": {
      "schema": "Product",
      "description": "Global products table"
    },
    "/companies/{companyId}/inventoryAdjustments/{adjustmentId}": {
      "schema": "InventoryAdjustment",
      "description": "Stock adjustments log"
    }
  }
}
