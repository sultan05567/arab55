rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ===============================================================
    // Global Deny
    // ===============================================================
    match /{document=**} {
      allow read, write: if false;
    }

    // ===============================================================
    // Helpers
    // ===============================================================
    
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isMemberOf(companyId) {
      return isSignedIn() && getUserData().companyId == companyId;
    }

    function hasPermission(perm) {
      let data = getUserData();
      return isSignedIn() && (
        data.isOwner == true || 
        (data.permissions is list && data.permissions.toSet().hasAny([perm]))
      );
    }

    // ===============================================================
    // Entities
    // ===============================================================

    // Users
    match /users/{userId} {
      allow read: if isOwner(userId) || (isSignedIn() && isMemberOf(resource.data.companyId) && hasPermission('users.manage'));
      
      allow create: if isSignedIn() && isOwner(userId) && 
                    request.resource.data.role == 'owner' && 
                    request.resource.data.isOwner == true;
      
      allow update: if isSignedIn() && (
        (isOwner(userId) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['fullName', 'phone'])) ||
        (isMemberOf(resource.data.companyId) && hasPermission('users.manage') && request.resource.data.companyId == resource.data.companyId)
      );
    }

    // Companies
    match /companies/{companyId} {
      allow read: if isMemberOf(companyId);
      
      allow create: if isSignedIn() && request.resource.data.ownerUid == request.auth.uid;
      
      allow update: if isMemberOf(companyId) && hasPermission('settings.view') && 
                    request.resource.data.ownerUid == resource.data.ownerUid;

      // Modules subcollection
      match /modules/{moduleId} {
        allow read: if isMemberOf(companyId);
        allow write: if isMemberOf(companyId) && hasPermission('settings.view');
      }

      match /invoices/{invoiceId} {
        allow read: if isMemberOf(companyId) && hasPermission('sales.view');
        allow create: if isMemberOf(companyId) && hasPermission('sales.create');
        allow update: if isMemberOf(companyId) && hasPermission('sales.edit');
      }

      match /inventoryAdjustments/{adjustmentId} {
        allow read: if isMemberOf(companyId) && hasPermission('inventory.view');
        allow create: if isMemberOf(companyId) && hasPermission('inventory.edit');
      }
    }

    // Products
    match /products/{productId} {
      allow read: if isSignedIn() && isMemberOf(resource.data.companyId) && hasPermission('inventory.view');
      allow create: if isSignedIn() && isMemberOf(request.resource.data.companyId) && hasPermission('inventory.edit');
      allow update: if isSignedIn() && isMemberOf(resource.data.companyId) && hasPermission('inventory.edit');
      allow delete: if isSignedIn() && isMemberOf(resource.data.companyId) && hasPermission('inventory.edit');
    }

    // Customers
    match /customers/{customerId} {
      allow read: if isSignedIn() && isMemberOf(resource.data.companyId) && hasPermission('customers.view');
      allow create: if isSignedIn() && isMemberOf(request.resource.data.companyId) && hasPermission('customers.create');
      allow update: if isSignedIn() && isMemberOf(resource.data.companyId) && hasPermission('customers.edit');
    }
  }
}
