rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ===============================================================
    // Global Deny
    // ===============================================================
    match /{document=**} {
      allow read, write: if false;
    }

    // ===============================================================
    // Helpers
    // ===============================================================
    
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function getProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isMemberOf(companyId) {
      return isSignedIn() && getProfile().companyId == companyId;
    }

    function hasPermission(perm) {
      let profile = getProfile();
      return isSignedIn() && (
        profile.isOwner == true || 
        (profile.permissions is list && profile.permissions.toSet().hasAny([perm]))
      );
    }
    
    function isCompanyOwner(companyId) {
      return isSignedIn() && get(/databases/$(database)/documents/companies/$(companyId)).data.ownerUid == request.auth.uid;
    }

    // ===============================================================
    // Entities
    // ===============================================================

    // Users
    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || (isSignedIn() && isMemberOf(resource.data.companyId) && hasPermission('users.manage')));
      allow list: if isSignedIn() && (isOwner(userId) || (isMemberOf(resource.data.companyId) && hasPermission('users.manage')));
      
      allow create: if isValidId(userId) && isSignedIn() && isOwner(userId) && 
                    request.resource.data.role == 'owner' && 
                    request.resource.data.isOwner == true;
      
      allow update: if isValidId(userId) && isSignedIn() && (
        (isOwner(userId) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['fullName', 'phone'])) ||
        (isMemberOf(resource.data.companyId) && hasPermission('users.manage') && request.resource.data.companyId == resource.data.companyId)
      );
    }

    // Companies
    match /companies/{companyId} {
      allow get: if isValidId(companyId) && isMemberOf(companyId);
      allow list: if isSignedIn() && resource.data.ownerUid == request.auth.uid;
      
      allow create: if isValidId(companyId) && isSignedIn() && request.resource.data.ownerUid == request.auth.uid;
      
      allow update: if isValidId(companyId) && (isMemberOf(companyId) || isCompanyOwner(companyId)) && 
                    (hasPermission('settings.view') || isCompanyOwner(companyId));

      // Modules subcollection
      match /modules/{moduleId} {
        allow get: if isValidId(moduleId) && isMemberOf(companyId);
        allow list: if isMemberOf(companyId);

        allow write: if isValidId(moduleId) && (isMemberOf(companyId) || isCompanyOwner(companyId)) && 
                     (hasPermission('settings.view') || isCompanyOwner(companyId));
      }

      match /invoices/{invoiceId} {
        allow get: if isValidId(invoiceId) && isMemberOf(companyId) && hasPermission('sales.view');
        allow list: if isMemberOf(companyId) && hasPermission('sales.view');

        allow create: if isValidId(invoiceId) && isMemberOf(companyId) && hasPermission('sales.create');
        allow update: if isValidId(invoiceId) && isMemberOf(companyId) && hasPermission('sales.edit');
      }

      match /inventoryAdjustments/{adjustmentId} {
        allow get: if isValidId(adjustmentId) && isMemberOf(companyId) && hasPermission('inventory.view');
        allow list: if isMemberOf(companyId) && hasPermission('inventory.view');

        allow create: if isValidId(adjustmentId) && isMemberOf(companyId) && hasPermission('inventory.edit');
      }
    }

    // Products
    match /products/{productId} {
      allow get: if isValidId(productId) && isSignedIn() && isMemberOf(resource.data.companyId) && hasPermission('inventory.view');
      allow list: if isSignedIn() && isMemberOf(resource.data.companyId) && hasPermission('inventory.view');

      allow create: if isValidId(productId) && isSignedIn() && isMemberOf(request.resource.data.companyId) && hasPermission('inventory.edit');
      allow update: if isValidId(productId) && isSignedIn() && isMemberOf(resource.data.companyId) && hasPermission('inventory.edit');
      allow delete: if isValidId(productId) && isSignedIn() && isMemberOf(resource.data.companyId) && hasPermission('inventory.edit');
    }

    // Customers
    match /customers/{customerId} {
      allow get: if isValidId(customerId) && isSignedIn() && isMemberOf(resource.data.companyId) && hasPermission('customers.view');
      allow list: if isSignedIn() && isMemberOf(resource.data.companyId) && hasPermission('customers.view');

      allow create: if isValidId(customerId) && isSignedIn() && isMemberOf(request.resource.data.companyId) && hasPermission('customers.create');
      allow update: if isValidId(customerId) && isSignedIn() && isMemberOf(resource.data.companyId) && hasPermission('customers.edit');
    }
  }
}
