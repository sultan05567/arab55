rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ===============================================================
    // Global Deny
    // ===============================================================
    match /{document=**} {
      allow read, write: if false;
    }

    // ===============================================================
    // Helpers
    // ===============================================================
    
    function isSignedIn() {
      return request.auth != null;
    }

    function isSameUser(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function getProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isMemberOf(companyId) {
      return isSignedIn() && getProfile().companyId == companyId;
    }

    function canAccess(companyId, perm) {
      return isSignedIn() && getProfile().companyId == companyId && (
        getProfile().isOwner == true || 
        getProfile().role == 'owner' ||
        getProfile().role == 'admin' ||
        (getProfile().permissions is list && perm in getProfile().permissions)
      );
    }
    
    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }
    
    function isCompanyOwner(companyId) {
      return isSignedIn() && get(/databases/$(database)/documents/companies/$(companyId)).data.ownerUid == request.auth.uid;
    }

    // ===============================================================
    // Entities
    // ===============================================================

    // Users
    match /users/{userId} {
      allow get: if isValidId(userId) && (isSameUser(userId) || (isSignedIn() && canAccess(resource.data.companyId, 'users.manage')));
      allow list: if isSignedIn() && (isSameUser(userId) || (canAccess(resource.data.companyId, 'users.manage')));
      
      allow create: if isValidId(userId) && isSignedIn() && isSameUser(userId) && 
                    request.resource.data.role == 'owner' && 
                    request.resource.data.isOwner == true;
      
      allow update: if isValidId(userId) && isSignedIn() && (
        (isSameUser(userId) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['fullName', 'phone'])) ||
        (canAccess(resource.data.companyId, 'users.manage') && request.resource.data.companyId == resource.data.companyId)
      );
    }

    // Companies
    match /companies/{companyId} {
      allow get: if isValidId(companyId) && isMemberOf(companyId);
      allow list: if isSignedIn() && resource.data.ownerUid == request.auth.uid;
      
      allow create: if isValidId(companyId) && isSignedIn() && request.resource.data.ownerUid == request.auth.uid;
      
      allow update: if isValidId(companyId) && (isMemberOf(companyId) || isCompanyOwner(companyId)) && 
                    (canAccess(companyId, 'settings.view') || isCompanyOwner(companyId));

      // Modules subcollection
      match /modules/{moduleId} {
        allow get: if isValidId(moduleId) && isMemberOf(companyId);
        allow list: if isMemberOf(companyId);

        allow write: if isValidId(moduleId) && (isMemberOf(companyId) || isCompanyOwner(companyId)) && 
                     (canAccess(companyId, 'settings.view') || isCompanyOwner(companyId));
      }

      match /invoices/{invoiceId} {
        allow get: if isValidId(invoiceId) && canAccess(companyId, 'sales.view');
        allow list: if canAccess(companyId, 'sales.view') && request.query.limit <= 100;

        allow create: if isValidId(invoiceId) && canAccess(companyId, 'sales.create');
        allow update: if isValidId(invoiceId) && canAccess(companyId, 'sales.edit');
      }

      match /inventoryAdjustments/{adjustmentId} {
        allow get: if isValidId(adjustmentId) && canAccess(companyId, 'inventory.view');
        allow list: if canAccess(companyId, 'inventory.view');

        allow create: if isValidId(adjustmentId) && canAccess(companyId, 'inventory.edit');
      }
    }

    // Products
    match /products/{productId} {
      allow get: if isValidId(productId) && isSignedIn() && canAccess(resource.data.companyId, 'inventory.view');
      allow list: if isSignedIn() && request.query.limit <= 100 && resource.data.companyId == getProfile().companyId && (
          getProfile().isOwner == true || 
          getProfile().role == 'owner' || 
          getProfile().role == 'admin' || 
          ('inventory.view' in getProfile().permissions)
      );

      allow create: if isValidId(productId) && isSignedIn() && canAccess(request.resource.data.companyId, 'inventory.edit');
      allow update: if isValidId(productId) && isSignedIn() && canAccess(resource.data.companyId, 'inventory.edit');
      allow delete: if isValidId(productId) && isSignedIn() && canAccess(resource.data.companyId, 'inventory.edit');
    }

    // Customers
    match /customers/{customerId} {
      allow get: if isValidId(customerId) && isSignedIn() && canAccess(resource.data.companyId, 'customers.view');
      allow list: if isSignedIn() && request.query.limit <= 100 && resource.data.companyId == getProfile().companyId && (
          getProfile().isOwner == true || 
          getProfile().role == 'owner' || 
          getProfile().role == 'admin' || 
          ('customers.view' in getProfile().permissions)
      );

      allow create: if isValidId(customerId) && isSignedIn() && canAccess(request.resource.data.companyId, 'customers.edit');
      allow update: if isValidId(customerId) && isSignedIn() && canAccess(resource.data.companyId, 'customers.edit');
    }
  }
}
